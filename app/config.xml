<?xml version="1.0" encoding="UTF-8"?>
<!-- BitChord for Samsung TV. GPL-3.0. A port of BitChord (jackychan4891/BitChord-PC-Official,
     kushagrasinghx/BitChord). Package id differs from the probe's, so both can be installed. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://bitchord.tv/app" version="0.2.0" viewmodes="maximized">
  <tizen:application id="bchordtv01.BitChord" package="bchordtv01" required_version="3.0"/>
  <tizen:profile name="tv-samsung"/>
  <name>BitChord</name>
  <description>Music from YouTube Music with synced lyrics, built for the remote.</description>
  <author href="https://github.com/haarryyyyyyy/bitchordtv-claude">BitChord TV contributors</author>
  <license href="https://www.gnu.org/licenses/gpl-3.0.html">GPL-3.0</license>
  <icon src="icon.png"/>
  <content src="index.html"/>
  <!-- Verified on a Tizen 6.5 TV: a packaged app with this access element reads youtubei,
       googlevideo and the lyric hosts directly; no proxy, no service app. -->
  <access origin="*" subdomains="true"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
